hex ::= [0-9a-fA-F]
int ::= "-"? ("0" | [1-9][0-9]*)
float ::= "-"? ("0" | [1-9][0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
bool ::= "true" | "false"
null ::= "null"
